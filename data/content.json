  "glossary": [
    {
      "term": "너프",
      "def": "게임 패치로 기술이나 포켓몬의 성능을 낮추는 것. 반대는 버프(상향)."
    },
    {
      "term": "버프",
      "def": "게임 패치로 기술이나 포켓몬의 성능을 높이는 것. 반대는 너프(하향)."
    },
    {
      "term": "평타",
      "def": "에너지를 모으는 기본(빠른) 공격. 영상에서 \"5번 만에 나간다\"는 말은 평타 5번이면 차지 기술이 나간다는 뜻."
    },
    {
      "term": "자속",
      "def": "포켓몬 자신의 타입과 같은 타입의 기술을 쓸 때 위력이 올라가는 효과."
    },
    {
      "term": "CMP",
      "def": "차지 기술 우선권(Charged Move Priority). 두 선수가 동시에 차지 기술을 누르면 한쪽이 먼저 발동한다."
    },
    {
      "term": "ELO",
      "def": "배틀리그에서 실력을 나타내는 점수. 이기면 오르고 지면 내려간다."
    },
    {
      "term": "인파이트",
      "def": "격투 타입의 강력한 차지 기술(Close Combat)."
    }
  ],
